{
  "model_type": "alloy",
  "tie_word_embeddings": false,
  "use_cache": true,

  "vocab_size": 32000,
  "hidden_size": 1024,
  "num_hidden_layers": 24,
  "max_position_embeddings": 4096,
  "initializer_range": 0.02,
  "hidden_act": "silu",

  "layer_types": [
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention", "dsv4_csa_attention", "dsv4_sliding_attention"
  ],
  "ffn_types": [
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp",
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp",
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp",
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp",
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp",
    "qwen3_mlp", "qwen3_mlp", "qwen3_mlp", "qwen3_mlp"
  ],

  "rms_norm_eps": 1e-06,
  "rms_norm_unit_offset": false,

  "rope_parameters": {
    "main":     {"rope_type": "default", "rope_theta": 10000.0, "partial_rotary_factor": 0.25},
    "compress": {"rope_type": "default", "rope_theta": 100000.0, "partial_rotary_factor": 0.25}
  },

  "num_attention_heads": 16,
  "num_key_value_heads": 1,
  "head_dim": 64,
  "attention_bias": false,
  "attention_dropout": 0.0,
  "attn_output_gate": false,
  "sliding_window": 512,

  "intermediate_size": 2816,

  "mlp_bias": false,
  "swiglu_limit": 10.0,

  "q_lora_rank": 256,
  "o_groups": 4,
  "o_lora_rank": 256,

  "index_n_heads": 8,
  "index_head_dim": 64,
  "index_topk": 32,

  "compress_rates": {
    "compressed_sparse_attention": 4,
    "heavily_compressed_attention": 16
  }
}
