{
  "model_type": "alloy",
  "tie_word_embeddings": false,
  "use_cache": true,

  "vocab_size": 1024,
  "hidden_size": 512,
  "num_hidden_layers": 12,
  "max_position_embeddings": 2048,
  "initializer_range": 0.01,
  "hidden_act": "silu",

  "layer_types": [
    "dsv4_hca_attention", "dsv4_hca_attention",
    "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention",
    "dsv4_csa_attention", "dsv4_sliding_attention",
    "dsv4_hca_attention", "dsv4_hca_attention",
    "dsv4_csa_attention", "dsv4_sliding_attention"
  ],
  "ffn_types": [
    "dsv4_hash_moe", "dsv4_hash_moe", "dsv4_hash_moe",
    "dsv4_moe", "dsv4_moe", "dsv4_moe",
    "dsv4_moe", "dsv4_moe", "dsv4_moe",
    "dsv4_moe", "dsv4_moe", "dsv4_moe"
  ],

  "rms_norm_eps": 1e-06,
  "rms_norm_unit_offset": false,

  "rope_parameters": {
    "main":     {"rope_type": "default", "rope_theta": 10000.0, "partial_rotary_factor": 0.25},
    "compress": {"rope_type": "default", "rope_theta": 100000.0, "partial_rotary_factor": 0.25}
  },

  "num_attention_heads": 8,
  "num_key_value_heads": 1,
  "head_dim": 64,
  "attention_bias": false,
  "attention_dropout": 0.0,
  "attn_output_gate": false,
  "sliding_window": 256,

  "intermediate_size": 1024,

  "n_routed_experts": 8,
  "num_experts_per_tok": 2,
  "moe_intermediate_size": 1024,
  "shared_expert_intermediate_size": 1024,
  "router_aux_loss_coef": 0.001,

  "mlp_bias": false,
  "swiglu_limit": 10.0,
  "scoring_func": "sqrtsoftplus",
  "routed_scaling_factor": 1.5,

  "q_lora_rank": 256,
  "o_groups": 4,
  "o_lora_rank": 256,

  "index_n_heads": 8,
  "index_head_dim": 64,
  "index_topk": 16,

  "compress_rates": {
    "compressed_sparse_attention": 4,
    "heavily_compressed_attention": 16
  }
}
